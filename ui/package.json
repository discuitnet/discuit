{
  "name": "ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run generate-yaml && vite",
    "dev:prod-proxy": "pnpm run generate-yaml && VITE_DEV_PROXY=https://discuit.org vite",
    "build-sw": "tsc -b && vite build --config sw.vite.config.js",
    "build": "pnpm run generate-yaml && tsc -b && vite build && pnpm run build-sw && pnpm run copy-sw",
    "lint": "oxlint --report-unused-disable-directives --max-warnings 0 && knip",
    "preview": "vite preview",
    "format": "oxfmt --write",
    "generate-yaml": "node scripts/generate-yaml.js",
    "copy-sw": "node scripts/copy-sw.js",
    "clean": "rm -rf dist/*"
  },
  "dependencies": {
    "@redux-devtools/extension": "^4.0.0",
    "clsx": "^2.1.1",
    "history": "^4.10.1",
    "prop-types": "^15.8.1",
    "pulltorefreshjs": "^0.1.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.1.2",
    "react-google-recaptcha": "^3.1.0",
    "react-helmet-async": "^3.0.0",
    "react-intersection-observer": "^11.0.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^7.2.9",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/history": "^4.7.11",
    "@types/node": "^26.6.6",
    "@types/prop-types": "^15.7.15",
    "@types/pulltorefreshjs": "^0.1.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/react-redux": "^7.1.35",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.2.1",
    "knip": "^6.44.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "sass-embedded": "^1.83.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-compression": "^0.5.1",
    "yaml": "^2.7.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  }
}
