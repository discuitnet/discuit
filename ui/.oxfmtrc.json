{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "es5",
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.html", "*.scss"],
      "options": {
        "tabWidth": 4,
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": ["node_modules", "/dist"]
}
